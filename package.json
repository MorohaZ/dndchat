{
  "name": "dndchat",
  "version": "0.1.0",
  "description": "LINE D&D Chat Bot with reliable event handling, distributed locking, and fair dice rolling",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "security:audit": "npm audit --audit-level=high",
    "security:gitleaks": "gitleaks detect --verbose --redact",
    "security:check": "npm run security:audit"
  },
  "keywords": [
    "dnd",
    "line-bot",
    "fastify",
    "kysely",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "ioredis": "^5.5.0",
    "kysely": "^0.29.6",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "jstat": "^1.9.6",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
