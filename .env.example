# Application
NODE_ENV=development
PORT=3000
# HOST: 127.0.0.1 binds to local loopback (safer when running outside containers).
# Set to 0.0.0.0 when running inside a Docker container to accept external traffic.
HOST=127.0.0.1
LOG_LEVEL=info

# Database (PostgreSQL 16) - Node.js App uses DATABASE_URL as Single Source of Truth
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dndchat

# Optional Docker Compose container initialization variables (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dndchat

# Cache & Distributed Locking (Redis 7) - Node.js App uses REDIS_URL as Single Source of Truth
REDIS_URL=redis://localhost:6379

# Distributed Lock Settings (TTL ceiling: 60000ms)
REDIS_LOCK_TTL_MS=5000
REDIS_LOCK_RETRY_COUNT=3
REDIS_LOCK_RETRY_DELAY_MS=200

# LINE Messaging API Secrets
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Rate Limit Configs (Configurable with upper bounds)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000

# User Message Rate Limit (Task 1.7: 1 command per 2 seconds)
RATE_LIMIT_USER_MESSAGES_MAX=1
RATE_LIMIT_USER_MESSAGES_WINDOW_MS=2000

# Group Message Rate Limit (Task 1.7: 10 commands per 10 seconds)
RATE_LIMIT_GROUP_MESSAGES_MAX=10
RATE_LIMIT_GROUP_MESSAGES_WINDOW_MS=10000

RATE_LIMIT_DICE_ROLLS_MAX=30
RATE_LIMIT_DICE_ROLLS_WINDOW_MS=60000
