# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dndchat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dndchat

# Cache & Distributed Locking (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Distributed Lock Settings
REDIS_LOCK_TTL_MS=10000
REDIS_LOCK_RETRY_COUNT=3
REDIS_LOCK_RETRY_DELAY_MS=200

# LINE Messaging API Secrets
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Rate Limit Configs (Configurable)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_USER_MESSAGES_MAX=10
RATE_LIMIT_USER_MESSAGES_WINDOW_MS=60000
RATE_LIMIT_DICE_ROLLS_MAX=30
RATE_LIMIT_DICE_ROLLS_WINDOW_MS=60000
