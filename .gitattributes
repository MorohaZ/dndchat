# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.gitleaksignore text eol=lf
